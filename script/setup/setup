#!/bin/bash

# script/setup: Setup script used by DevContainers to prepare the project
#
# Installs optional development tools (pyright, GitHub Copilot CLI, git-cliff)
# and configures the environment. Called automatically by DevContainer postStartCommand.
#
# Usage:
#   ./script/setup/setup
#
# Examples:
#   ./script/setup/setup

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$SCRIPT_DIR/.."

# shellcheck source=script/.lib/output.sh
source "$SCRIPT_DIR/.lib/output.sh"
# shellcheck source=script/.lib/download.sh
source "$SCRIPT_DIR/.lib/download.sh"

# Load environment overrides in two layers (later layers win):
#   .devcontainer/.env       — project-level defaults, committed to the repo
#   .devcontainer/.env.local — user/machine-specific overrides, gitignored
# bootstrap also sources these files, but as a subprocess its env changes don't propagate back.
# Sourcing here ensures HA_INSTALL_HACS and other vars are available in this script too.
_env_file=".devcontainer/.env"
if [[ -f "$_env_file" ]]; then
    # shellcheck source=/dev/null
    source "$_env_file"
fi
unset _env_file
_env_local=".devcontainer/.env.local"
if [[ -f "$_env_local" ]]; then
    # shellcheck source=/dev/null
    source "$_env_local"
fi
unset _env_local

"$SCRIPT_DIR/setup/bootstrap"

activate_venv

# Because of the -e (editable) flag, any changes you make to the Python code will be
# reflected immediately the next time you run your script or tests.
log_header "Installing pyhaopenmotics package in editable mode"
uv pip install --editable .

echo ""
log_success "Project setup complete"
